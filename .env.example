# 复制为 .env 后修改。.env 不得提交。以下均为占位说明，不含真实密钥。
APP_ENV=local
# SQLite 默认；PostgreSQL 示例：postgresql+psycopg://bio_user:CHANGE_ME@db:5432/bioplatform
DATABASE_URL=sqlite:///data/app.db
# API 访问令牌；本地可用示例值，部署必须替换为足够长的随机串
API_TOKEN=local-dev-token-change-me
# deterministic（默认，完全离线）/ deepseek（在线，发送前脱敏）
LLM_PROVIDER=deterministic
# 仅 LLM_PROVIDER=local（尚未实现）时使用，指向本地模型目录。不要把 API 密钥写在这里。
LOCAL_MODEL_PATH=
# 仅 LLM_PROVIDER=deepseek 时需要；密钥只放在 .env，不要提交
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Docker 部署里启用在线模型需叠加 docker-compose.llm.yml（受控出网，详见 SPEC 第 14 节）；默认部署固定 deterministic
AUDIT_JSONL_DIR=data/audit
API_BASE_URL=http://127.0.0.1:8000

# 浏览器登录用户：python scripts/make_ui_user.py <用户名> 生成一行 `用户名:scrypt$…`；多个用户用分号隔开，整体用单引号包住
UI_USERS=

# ---------- 仅 docker compose 部署使用（本地开发 / 测试 / 评测不需要）----------
# 数据库口令：部署时必须设置为强随机串
POSTGRES_PASSWORD=
# 对外域名；留空或 localhost 时 Caddy 使用本地自签证书
DOMAIN=localhost
# 访问页面的 basic auth 用户名，以及用 `docker run --rm caddy:2-alpine caddy hash-password` 生成的 bcrypt 哈希。
# 哈希含 $ 字符，必须用单引号包住： BASIC_AUTH_HASH='$2a$14$....'
BASIC_AUTH_USER=
BASIC_AUTH_HASH=
# 镜像标签（可选）
APP_VERSION=local
